{
  "name": "jxpd-replay",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode localdev",
    "devhost": "vite --mode localdev --host",
    "dev:edgeone": "vite",
    "build": "vite-ssg build && node scripts/create-spa-fallbacks.mjs",
    "build:ssg": "vite-ssg build",
    "build:verify": "node scripts/verify-ssg-build.mjs",
    "start": "vite preview",
    "lint": "oxlint src cloud-functions dev tests scripts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "invite:hash": "node scripts/hash-replay-invite.mjs",
    "format": "oxfmt",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.16",
    "@icon-park/vue-next": "^1.4.2",
    "@unhead/vue": "^2.1.17",
    "brotli-wasm": "^3.0.1",
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0"
  },
  "type": "module"
}
